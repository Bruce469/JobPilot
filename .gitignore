# ZCode 工作区与本地分析产物
.zcode/

# 前端
frontend/node_modules/
frontend/dist/
frontend/coverage/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/

# 运行数据与日志（个人数据 / 数据集不入库，防二次分发）
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
backend/market/data/
backend/market/logs/
backend/backend.log
*.log

# 自动补全离线数据（脚本构建产物，不入库；运行 scripts/*.py 生成）
backend/app/fetcher/company_info_data.json
backend/scripts/company_db_progress.json
backend/scripts/roster_raw.json

# 环境与临时
.env
last_export.json
*.tmp
.DS_Store

# 简历源 PDF 附件（个人简历不入库）
backend/data/resume_files/
